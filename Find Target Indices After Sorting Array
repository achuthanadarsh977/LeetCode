function targetIndices(nums: number[], target: number): number[] {

    let r = nums.sort((a,b) => a - b)
    
    let res = []
    let higher = binarySearch(r,target,false)
    let lower = binarySearch(r,target,true)

    for(let i = lower;i <= higher;i++){
        res.push(i)
    }

    return res


};


function binarySearch(nums,target,isLeft){
    let left = 0
    let right = nums.length - 1
    let mid = 0
    let res

    while(left <= right){
        mid = Math.floor((left+right)/2)

        if(target > nums[mid]){
            left = mid + 1
        }

        else if(target < nums[mid]){
            right = mid - 1
        }

        else{
            res = mid
            if(isLeft){
                right = mid - 1
            }

            else{
                left = mid + 1
            }
        }
    }

    return res;
}
