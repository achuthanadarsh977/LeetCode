function minSubArrayLen(target: number, nums: number[]): number {
    let left = 0
    let sum = 0

    let maximum = Infinity;

    for(let right = 0;right < nums.length;right++){
        sum+=nums[right];

        while(sum >= target){
            maximum = Math.min(maximum,right - left+1)
            sum-=nums[left]
            left++;
        }


    }

    return maximum === Infinity ? 0 : maximum
};
