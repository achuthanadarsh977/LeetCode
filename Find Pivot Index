function pivotIndex(nums: number[]): number {

    const sumLeft:number[] = []
    const sumRight:number[] = []
    const n = nums.length

    let sum=0

    for(let i=n-1;i>=0;i--){
        sum+=nums[i]
        sumRight[i]=sum
    }

    sum=0
    for(let i=0;i<=n;i++){
        sum+=nums[i]
        sumLeft[i]=sum
    }

    for(let i=0;i<=n;i++){
        if(sumLeft[i] === sumRight[i]){
            return i
        }
    }

    return -1
    
};
