function findMaxAverage(nums: number[], k: number): number {
    let n = nums.length
    let sum = 0
    for(let i=0;i<k;i++){
        sum+=nums[i]
    }

    let maxsum = sum / k

    for(let i=k;i<n;i++){
        sum+=nums[i] - nums[i-k]
        maxsum = Math.max(maxsum,sum / k)
    }

    return maxsum
};
