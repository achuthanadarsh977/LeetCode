function subsets(nums: number[]): number[][] {
    let n = nums.length
    let res = []
    let sol = []

    function backtrack(i:number):void{
        if(i === n){
            res.push([...sol])
            return
        }
        backtrack(i+1)
        sol.push(nums[i])
        backtrack(i+1)
        sol.pop()
    }
    
    backtrack(0)
    return res
    
};
