function strongPasswordCheckerII(password: string): boolean {


    const seen = new Set()
    for(let i=0;i < password.length;i++){
        const c = password.charAt(i)
        if(i>0 && c === password.charAt(i-1)){
            return false
        }

        if(/[a-z]/.test(c)){
            seen.add('l')
        }

        else if(/[A-Z]/.test(c)){
            seen.add('u')
        }

        else if(/[0-9]/.test(c)){
            seen.add('d')
        }


        else{
            seen.add('s')
        }
    }

    if((password.length >= 8) && (seen.size === 4)){
        return true
    }
    
    return false
};
