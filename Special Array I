function isArraySpecial(nums: number[]): boolean {

    function parity(x:number):string{

        if(x%2 === 1){
            return "odd"
        }

        return "even"
    }

    for(let i = 1;i<nums.length;i++){
        if(parity(nums[i]) === parity(nums[i-1])){
            return false
        }
    }

    return true
    
};
