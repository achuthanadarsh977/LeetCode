function findDisappearedNumbers(nums: number[]): number[] {

    let numset = new Set()
    let res = []
    let ref = 1



    for(let i=0;i<nums.length;i++){
        numset.add(nums[i])
    }

    for(let i=0;i<nums.length;i++){
        if(!numset.has(ref)){
            res.push(ref)
        }
        ref++;
    }
    return res
};
