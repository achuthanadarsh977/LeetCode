function minimumBoxes(apple: number[], capacity: number[]): number {
    capacity = capacity.sort((a,b) => b - a,)
    let sum=0
    let boxes=0
    let r = apple.reduce((a,b) => a+b,0)

    for(let i=0;i<capacity.length;i++){
        sum+=capacity[i]
        boxes++;
        if(sum >= r){
            break
        }
    }

    return boxes


};
