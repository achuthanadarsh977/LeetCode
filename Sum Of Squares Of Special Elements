function sumOfSquares(nums: number[]): number {
    
    let n = nums.length
    let z:number[] = []
    for(let i=0;i<n;i++){
        if(n%(i+1) === 0){
            z.push(nums[i])
        }
    }

    let sum=0
    for(let k=0;k<z.length;k++){
        let val = z[k]
        sum+=val * val;
    }


    return sum;


};
