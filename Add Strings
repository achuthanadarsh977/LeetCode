function addStrings(num1: string, num2: string): string {

   let sb:string[] = []
   let i = num1.length  - 1
   let j = num2.length - 1

   let carry = 0

   while(i >= 0 || j >= 0){
      let sum = carry

   if(i >= 0){
       sum+=parseInt(num1[i]);
       i--;
   }

   if(j >= 0){
      sum+=parseInt(num2[j])
      j--;
   }

     sb.push((sum%10).toString())
     carry = Math.floor(sum / 10)
   }

   if(carry > 0){
       sb.push(carry.toString())
   }

   return sb.reverse().join("")



};
