function canConstruct(ransomNote: string, magazine: string): boolean {

    const freq:Record<string,number> = {}


    for(const char of magazine){
        freq[char] = (freq[char] || 0) + 1
    }


    for(const char of ransomNote){
        if(!freq[char] || freq[char] === 0){
            return false
        }

        freq[char]--;
    }

    return true
    
};
