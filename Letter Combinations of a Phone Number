function letterCombinations(digits: string): string[] {

    if(!digits.length){
        return []
    }
    
    let res:string[] = []

    let phone: Record<string,string> = {
        "2":"abc",
        "3":"def",
        "4":"ghi",
        "5":"jkl",
        "6":"mno",
        "7":"pqrs",
        "8":"tuv",
        "9":"wxyz"
    }

    function backtrack(i:number,curStr:string):void{
        if(curStr.length === digits.length){
            res.push(curStr)
            return;
        }

        for (let c of phone[digits[i]]){
            backtrack(i + 1,curStr + c)
        } 

    }
    
    backtrack(0,"")
    return res;
    
};
