function findRepeatedDnaSequences(s: string): string[] {

    let r = s.length
    let remy = new Map<string,number>()
    let result:string[] = [] 

    if(r < 10){
        return []
    }

    for(let i=0;i<=(r-10);i++){
        let sub = s.slice(i,i+10)

        remy.set(sub , (remy.get(sub) || 0)+1)
        
    }

    for (let [key,values] of remy.entries()){
         if(values > 1){
            result.push(key)
         }

    }
    return result
};
