SELECT DISTINCT visited_on, 
       amount, 
       ROUND(amount/7, 2) AS average_amount
FROM (
    SELECT visited_on,
           SUM(amount) OVER (
               ORDER BY visited_on
               RANGE BETWEEN INTERVAL 6 DAY PRECEDING AND CURRENT ROW
           ) AS amount,
           MIN(visited_on) OVER() AS day_1
    FROM Customer
) t
WHERE visited_on >= DATE_ADD(day_1, INTERVAL 6 DAY);
