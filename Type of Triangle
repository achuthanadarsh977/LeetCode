function triangleType(nums: number[]): string {
    if (nums.length !== 3) {
    return "Invalid input";
  }
    const [a,b,c] = nums

    if(a === b && b === c){
        return "equilateral"
    }

    else if((a === b || b === c || a === c) && ((a+b)>c) && ((a+c)>b) && ((b+c)>a)){
        return "isosceles"
    }

    else if (a + b <= c || b+c<=a || a+c<=b){
        return "none"
    }


    else{
        return "scalene"
    }





};
