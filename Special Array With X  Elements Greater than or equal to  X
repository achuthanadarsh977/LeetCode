function specialArray(nums: number[]): number {

    nums.sort()
    let left = 0
    let right = nums.length 

    while(left <= right){
        let mid = Math.floor((left+right)/2)
        let curr = count(nums,mid)

        if(curr === mid){
            return mid
        }

        else if(curr>mid){
            left = mid+1
        }

        else if(curr < mid){
            right=mid-1
        }
    }

    return -1
};


function count(nums:number[],t:number):number{
    let c=0

    for(let i of nums){
        if(i>=t){
            c++;
        }
    }

    return c;
}
