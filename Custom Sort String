function customSortString(order: string, s: string): string {
    
    const count = new Map<string,number>()


    for(const ch of s){
        count.set(ch , (count.get(ch) || 0) + 1)
    }

    let result = ''

    for(const cs of order){
        if(count.has(cs)){
            result += cs.repeat(count.get(cs)!)
            count.delete(cs)
        }
    }


    for(const [cr,freq] of count){
        result += cr.repeat(freq)
    }


    return result


 
};


