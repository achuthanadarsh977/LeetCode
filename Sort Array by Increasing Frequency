function frequencySort(nums: number[]): number[] {

    const frequency = {};

    for(const num of nums){
        frequency[num] = (frequency[num] || 0) + 1;
    }

    return nums.sort((a,b) =>{
        if (frequency[a] === frequency[b]){
            return b - a;
        }

        return frequency[a] - frequency[b];
    })
    
};
