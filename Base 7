function convertToBase7(num: number): string {

    if (num === 0) return "0"

    let negative = num < 0
    num = Math.abs(num)

    let digit:string[] = []

    while (num > 0){
        let remainder = (num % 7)
        digit.push(remainder.toString())
        num = Math.floor(num/7)
    }

    let result = digit.reverse().join('')
    return negative ? "-" + result : result;  

};
