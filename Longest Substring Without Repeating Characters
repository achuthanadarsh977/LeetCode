function lengthOfLongestSubstring(s: string): number {

    let set1 = new Set<String>()
    let maxl = 0
    let left = 0

    for(let right=0;right < s.length;right++){
        while(set1.has(s[right])){
            set1.delete(s[left]);
            left++;
        }

        set1.add(s[right])
        maxl = Math.max(maxl,right-left+1)
    }

    return maxl




