function maxProduct(nums: number[]): number {

    let res = Math.max(...nums)
    let cur_max = 1
    let cur_min = cur_max

    for(let i = 0;i<nums.length;i++){
        const n = nums[i]
        const temp = cur_max * n
        cur_max = Math.max(temp,cur_min*n,n)
        cur_min = Math.min(temp,cur_min*n,n)
        res  = Math.max(res,cur_max)
    }

    return res


    
    
};
